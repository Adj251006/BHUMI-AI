# =============================================================================
# National Land Acquisition & Management System — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# PostgreSQL connection string (Supabase)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Application secret key for JWT signing (will be used in Module 2)
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-secure-random-string

# Environment: development | staging | production
ENVIRONMENT=development
